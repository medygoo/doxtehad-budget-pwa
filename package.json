{
  "name": "carnet-budget-doxtehad",
  "version": "2.0.0",
  "description": "Application PWA de gestion budgétaire autonome basée sur la règle 75/15/10",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "npx http-server . -p 8080 -c-1",
    "lint": "eslint js/*.js",
    "lint:fix": "eslint js/*.js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "npm run lint && npm run test && npm run test:e2e",
    "validate": "npm run lint && npm run format:check && npm run test:all"
  },
  "keywords": [
    "budget",
    "finance",
    "pwa",
    "offline-first",
    "localStorage",
    "75-15-10"
  ],
  "author": "DOXTEHAD",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@vitest/browser": "^2.1.5",
    "@vitest/ui": "^2.1.5",
    "eslint": "^9.14.0",
    "happy-dom": "^15.11.7",
    "http-server": "^14.1.1",
    "playwright": "^1.48.2",
    "prettier": "^3.3.3",
    "vitest": "^2.1.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
